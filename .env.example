# Bot token only, never a user token. Keep the real .env private.
DISCORD_TOKEN=
# Default guild is a convenience, not an access restriction.
DISCORD_GUILD_ID=
# Optional JSON array of STRING IDs. Omit to allow every guild the bot can access.
# [] explicitly denies all guilds.
# DISCORD_ALLOWED_GUILD_IDS='["123456789012345678"]'
DISCORD_INTENT_MESSAGE_CONTENT=false
DISCORD_INTENT_MEMBERS=false
# Private-message tools are opt-in and still require a selected allowed guild + current membership.
DISCORD_ENABLE_DMS=false
MCP_HOST=127.0.0.1
MCP_PORT=8085
# Allowed HTTP Host headers, JSON array; include additional exact hosts for other containers.
MCP_ALLOWED_HOSTS='["localhost:*","127.0.0.1:*","[::1]:*","discord-mcp:8085"]'
MCP_ALLOWED_ORIGINS='[]'
LOG_LEVEL=INFO
DISCORD_READY_TIMEOUT=30
DISCORD_OPERATION_TIMEOUT=30
DISCORD_SHUTDOWN_TIMEOUT=10
